@page "/entries"
@inject IJournalService _journalService

@code {
    public IEnumerable<JournalEntry>? JournalEntries { get; set; }

    protected override async Task OnInitializedAsync()
    {
        JournalEntries = await _journalService.GetJournalEntriesAsync();
    }
}

<div class="row">
    <h1 class="display-2">Journal Entries</h1>
    <table class="table">
        <thead class="thead-inverse">
            <tr>
                <th>Date</th>
                <th>Rating</th>
                <th>Comment</th>
            </tr>
        </thead>
        <tbody>
            @if (JournalEntries is not null)
            {
                @foreach (var entry in JournalEntries)
                {
                    <tr>
                        <td>@entry.Date</td>
                        <td>@entry.Rating</td>
                        <td>@entry.Comment</td>
                        <td>
                            <a class="btn btn-primary" href="editentry/@entry.Id.ToString()">Edit</a>
                            <button class="btn btn-danger">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
