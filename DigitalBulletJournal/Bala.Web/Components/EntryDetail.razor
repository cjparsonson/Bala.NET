<p>Current Comment: @journalEntry.Comment</p>

<EditForm FormName="JournalEntry" Model="@journalEntry" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <div>
        <label class="form-label">Date</label>
        <div>
            <InputDate @bind-Value="@journalEntry.Date" class="form-control" />
            <ValidationMessage For="@(() => journalEntry.Date)" />
        </div>
    </div>
    <div>
        <label class="form-label">Rating</label>
        <div>
            <InputNumber @bind-Value="@journalEntry.Rating" class="form-control" />
            <ValidationMessage For="@(() => journalEntry.Rating)" />
        </div>
    </div>
    <div>
        <label class="form-label">Comment</label>
        <div>
            <InputText @bind-Value="@journalEntry.Comment" class="form-control" />
            <ValidationMessage For="@(() => journalEntry.Comment)" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>
<p>Debug (Inside EntryDetail): @journalEntry.Comment</p>


@code {
    [Parameter]
    public JournalEntry journalEntry { get; set; } = null!;
    [Parameter]
    public EventCallback OnValidSubmit { get; set; }
    private async Task HandleValidSubmit()
    {
        await OnValidSubmit.InvokeAsync(journalEntry);
    }
}    