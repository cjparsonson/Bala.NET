@page
@model Bala.Web.Pages.EntriesModel

<div class="row">
    <h1 class="display-2">Journal Entries</h1>
    <table class="table">
        <thead class="thead-inverse">
            <tr>
                <th>Date</th>
                <th>Rating</th>
                <th>Comment</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Entries is not null)
            {
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@entry.Date</td>
                        <td>@entry.Rating</td>
                        <td>@entry.Comment</td>
                        <td>
                            <a class="btn btn-primary" asp-page="Edit" asp-route-id="@entry.Id">Edit</a>
                            <button class="btn btn-danger">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
