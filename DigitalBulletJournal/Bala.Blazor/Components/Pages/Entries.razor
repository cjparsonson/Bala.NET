@page "/entries"
@inject IJournalService _service

<h3>Entries</h3>

@if (entries == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Rating</th>
                <th>Comment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td>@entry.Date.ToShortDateString()</td>
                    <td>@entry.Rating</td>
                    <td>@entry.Comment</td>
                    <td>
                        <a class="btn btn-info" href="editentry/@entry.Id">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a class="btn btn-danger" href="deleteentry/@entry.Id">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private List<JournalEntry>? entries { get; set; }
    protected override async Task OnInitializedAsync()
    {
        entries = await _service.GetJournalEntriesAsync();
    }
}